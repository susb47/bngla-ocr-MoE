# moe-docs environment variables
# Copy to .env and fill in values

# Path where corpus data lives (default: ./corpus)
MOEDOCS_CORPUS_DIR=./corpus

# Path to sources.yml
MOEDOCS_SOURCES_FILE=./sources.yml

# OCR engine to use by default (tesseract | surya | paddle)
MOEDOCS_OCR_ENGINE=tesseract

# Tesseract language pack
MOEDOCS_TESSERACT_LANG=ben+eng

# DPI for page images used by the review UI
MOEDOCS_VIEW_DPI=150

# DPI for OCR (higher = better quality, slower)
MOEDOCS_OCR_DPI=300

# FastAPI
MOEDOCS_API_HOST=0.0.0.0
MOEDOCS_API_PORT=8000

# Optional: path to the chatbot KB folder for export
MOEDOCS_KB_EXPORT_DIR=../moe-bot/data/kb

# Optional: LibreOffice binary (if not on PATH)
# LIBREOFFICE_PATH=/usr/bin/libreoffice
